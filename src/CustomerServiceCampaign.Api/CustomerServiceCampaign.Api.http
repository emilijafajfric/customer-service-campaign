@host = http://localhost:5179
@agentToken = YOUR_AGENT_TOKEN
@adminToken = YOUR_ADMIN_TOKEN

### Agent login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "agent1",
  "password": "Agent123!"
}

### Reward without token - expected 401
POST {{host}}/api/rewards
Content-Type: application/json

{
  "campaignId": "11111111-1111-1111-1111-111111111111",
  "agentId": "22222222-2222-2222-2222-222222222222",
  "customerId": "1"
}

### Reward real SOAP customer as Agent
POST {{host}}/api/rewards
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "campaignId": "11111111-1111-1111-1111-111111111111",
  "agentId": "22222222-2222-2222-2222-222222222222",
  "customerId": "1"
}

### Reward another SOAP customer as Agent
POST {{host}}/api/rewards
Authorization: Bearer {{agentToken}}
Content-Type: application/json

{
  "campaignId": "11111111-1111-1111-1111-111111111111",
  "agentId": "22222222-2222-2222-2222-222222222222",
  "customerId": "2"
}

### Purchase import as Agent - expected 403
POST {{host}}/api/purchases/import
Authorization: Bearer {{agentToken}}
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="file"; filename="purchases.csv"
Content-Type: text/csv

< ../../samples/purchases.csv
--Boundary--

### Admin login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin123!"
}

### Purchase import as Admin
POST {{host}}/api/purchases/import
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="file"; filename="purchases.csv"
Content-Type: text/csv

< ../../samples/purchases.csv
--Boundary--

### Invalid purchase import as Admin - expected 400
POST {{host}}/api/purchases/import
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="file"; filename="invalid-purchases.csv"
Content-Type: text/csv

< ../../samples/invalid-purchases.csv
--Boundary--

### Campaign results as Admin
GET {{host}}/api/campaigns/11111111-1111-1111-1111-111111111111/results
Authorization: Bearer {{adminToken}}
Accept: application/json

### Unknown campaign as Admin - expected 404
GET {{host}}/api/campaigns/99999999-9999-9999-9999-999999999999/results
Authorization: Bearer {{adminToken}}
Accept: application/json